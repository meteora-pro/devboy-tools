# LLM Eval — API keys and model IDs
# Copy to .env and fill in your values
# Run from the repo root: cargo run -p llm-eval --release

# ── Kimi (Moonshot AI) ────────────────────────────────────────────────────────
KIMI_API_KEY=sk-...
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-32k

# ── Zhipu GLM ─────────────────────────────────────────────────────────────────
ZHIPU_API_KEY=...
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-5.1

# ── Local Ollama (shared base URL for all local models) ───────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1

# Gemma — set GEMMA_MODEL to enable
GEMMA_MODEL=gemma4:26b

# GPT-OSS — set GPTOSS_MODEL to enable
GPTOSS_MODEL=gpt-oss:20b
