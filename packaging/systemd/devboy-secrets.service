[Unit]
# The secret daemon (ADR-023 §3.3, ADR-024 §7).
#
# Installed as a *user* unit, not a system one: the vault belongs
# to one person, and a system service would either need to
# multiplex every user's keys through one process or run as root.
# Neither is acceptable — see ADR-024 §7 on multi-user hosts.
Description=DevBoy secret daemon
Documentation=https://github.com/meteora-pro/devboy-tools/blob/main/docs/architecture/adr/ADR-024-agent-mediated-vault-access-totp-and-audit-log.md

# The socket lives under the user's runtime/config dir, so the
# daemon has nothing to wait for at the system level.
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/devboy-secrets-agent

# Why this unit exists at all: a daemon started from a shell is a
# descendant of that shell, and anything else in the same process
# tree can ptrace it under kernel.yama.ptrace_scope=1. systemd
# starts it as a child of the user manager instead, which is what
# lets the daemon report trust_level=independent. Starting the
# binary by hand is refused by design (ADR-024 §7 check B).

# No controlling terminal — check C. StandardInput=null is what
# actually guarantees it; without this the unit could inherit one
# in some launch paths.
StandardInput=null
StandardOutput=journal
StandardError=journal

# Restart on crashes, but never fight a deliberate stop, and never
# loop on a refusal: exit code 1 is how the daemon reports a failed
# provenance check, and retrying that forever would bury the
# explanation in the journal.
Restart=on-failure
RestartSec=2
SuccessExitStatus=0
RestartPreventExitStatus=1

# The vault key lives in this process's memory. Deny the obvious
# ways of getting at it or at the filesystem around it.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/devboy-tools %h/.local/state/devboy-tools
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

# Keeping the key out of a core dump or swap is the whole point of
# zeroizing it on drop; these close the two paths that would leak
# it anyway.
LimitCORE=0
UMask=0077

# SIGTERM triggers the zeroize path; ADR-023 §3.3 allows 10s.
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=default.target
