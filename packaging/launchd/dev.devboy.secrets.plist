<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The secret daemon (ADR-023 §3.3, ADR-024 §7).

  A LaunchAgent, not a LaunchDaemon: the vault belongs to one
  person, and a system-wide daemon would have to multiplex every
  user's keys through a single process.

  Install to ~/Library/LaunchAgents/dev.devboy.secrets.plist and
  load with:

    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.devboy.secrets.plist

  launchd reparents the process to itself, which is what lets the
  daemon report trust_level=independent. Starting the binary from
  a shell is refused by design (ADR-024 §7 check B), because a
  shell-started daemon is a descendant of that shell and anything
  in the same process tree can read its memory.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.devboy.secrets</string>

    <key>ProgramArguments</key>
    <array>
        <!-- Rewritten by the installer to an absolute path;
             launchd does not expand ~ or consult PATH. -->
        <string>/usr/local/bin/devboy-secrets-agent</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart on crashes, but do not loop on a refusal: exit
         code 1 is how the daemon reports a failed provenance
         check, and relaunching that forever would bury the
         explanation. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- No controlling terminal — ADR-024 §7 check C. -->
    <key>StandardInPath</key>
    <string>/dev/null</string>
    <key>StandardOutPath</key>
    <string>/tmp/devboy-secrets.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/devboy-secrets.err.log</string>

    <!-- Interactive: the daemon may need to render an unlock
         prompt, so it must not be background-throttled. -->
    <key>ProcessType</key>
    <string>Interactive</string>

    <!-- Keep the vault key out of core dumps; it is zeroized on
         drop, which a dump would defeat. -->
    <key>HardResourceLimits</key>
    <dict>
        <key>Core</key>
        <integer>0</integer>
    </dict>
    <key>SoftResourceLimits</key>
    <dict>
        <key>Core</key>
        <integer>0</integer>
    </dict>

    <key>Umask</key>
    <integer>63</integer>
</dict>
</plist>
