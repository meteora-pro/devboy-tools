# === Paper 1 benchmark workbench — env template ===
# Copy this to `.env` and fill in real values.
# The `.env` file is gitignored; NEVER commit it.

# ---- Ollama (local, remote host) ----
# Example: http://10.0.0.42:11434 or http://hostname.local:11434
OLLAMA_BASE_URL=http://YOUR_OLLAMA_HOST:11434
# Optional if your Ollama requires auth (usually unset):
# OLLAMA_API_KEY=

# ---- Anthropic (Messages API + Batch API) ----
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE
# Optional override; leave default unless you have a proxy
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ---- z.ai coding plan (Anthropic-compatible endpoint, for GLM-4.6) ----
ZAI_API_KEY=YOUR_ZAI_KEY_HERE
ZAI_BASE_URL=https://api.z.ai/api/anthropic
ZAI_MODEL=glm-4.6

# ---- Moonshot (Kimi for coding) — optional ----
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# ---- HuggingFace (for SWE-bench download) ----
HF_TOKEN=

# ---- Paths (leave defaults unless you have reason) ----
SWE_BENCH_CACHE_DIR=./artifacts/swe_bench_cache
REPOS_CACHE_DIR=./artifacts/repos_cache

# ---- Run behavior ----
# Max concurrent requests per provider (tune for rate limits)
ANTHROPIC_CONCURRENCY=4
OLLAMA_CONCURRENCY=1
ZAI_CONCURRENCY=8

# Checkpoint frequency for long LLM runs
CHECKPOINT_EVERY=25
